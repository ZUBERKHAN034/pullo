    "Each kind of alert can play its own sound. Default uses the sound above.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada tipo de alerta puede reproducir su propio sonido. Predeterminado usa el sonido de arriba."
          }
